{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AInode",
  "version": "0.9.3",
  "identifier": "com.m2promende.ainode",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1450",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": false,
    "windows": [
      {
        "label": "main",
        "title": "AInode",
        "width": 460,
        "height": 760,
        "minWidth": 420,
        "minHeight": 640,
        "resizable": true,
        "maximizable": false,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#000000",
        "incognito": true,
        "dragDropEnabled": false,
        "acceptFirstMouse": true,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* https://easybtx.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "resources": ["resources/**/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": { "minimumSystemVersion": "13.0" }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZBQzQwRDFERkIyRERBOUEKUldTYTJpMzdIUTNFK2xnMmM4YkFiVEIzUElTNHljaUV5QkhoRjVBRk1UazN5R3dWaVB3SnNuYmMK",
      "endpoints": ["https://github.com/MendeMatthias/ainode-releases/releases/latest/download/latest.json"]
    }
  }
}
